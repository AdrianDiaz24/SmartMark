# Backend SmartMark - Variables de Entorno

# ===== SERVIDOR =====
# Puerto en el que escucha el servidor
PORT=3000

# Entorno de ejecución (development, production)
NODE_ENV=development

# ===== BASE DE DATOS =====
# Ruta a archivo SQLite
DATABASE_PATH=./src/database/smartmark.db

# ===== CORS =====
# URL del frontend permitida para CORS
# Ejemplos:
#   Desarrollo local: http://localhost:3001
#   Docker: http://frontend (nombre del servicio en docker-compose)
#   Railway: https://frontend.vercel.app
CORS_ORIGIN=http://localhost:3001

# ===== AUTENTICACIÓN =====
# Clave secreta para firmar JWT
JWT_SECRET=tu_clave_secreta

# Tiempo de expiración del JWT
JWT_EXPIRE=7d

# ===== VERIFICACIÓN DE URLs =====
# Intervalo de verificación de URLs en milisegundos
# Por defecto: 7 días = 604800000 ms
VERIFICATION_INTERVAL=604800000

# ===== LÍMITES =====
# Tamaño máximo de archivo de portada en MB
MAX_FILE_SIZE_MB=5

# ===== API EXTERNA =====
# Timeout para peticiones HTTP en milisegundos
HTTP_TIMEOUT=5000

